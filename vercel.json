{
  "version": 2,
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  },
  "rewrites": [
    {
      "source": "/api/town/:path*",
      "destination": "/api/town-proxy"
    }
  ],
  "routes": [
    {
      "src": "/blood-on-the-clocktower/(.*)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
