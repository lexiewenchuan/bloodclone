{
  "name": "blood-on-the-clocktower",
  "private": true,
  "version": "2.0.18",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "generate-script-index": "node scripts/generate-script-index.js",
    "normalize": "node scripts/normalize-scripts.js",
    "watch-scripts": "node scripts/generate-script-index.js --watch",
    "localize-images": "node scripts/localize-images.js",
    "localize-scripts-index": "node scripts/localize-scripts-index.js",
    "save": "./scripts/git-manager.sh sync",
    "release": "./scripts/git-manager.sh release",
    "undo": "./scripts/git-manager.sh undo",
    "reset": "./scripts/git-manager.sh reset",
    "history": "./scripts/git-manager.sh history",
    "versions": "./scripts/git-manager.sh versions",
    "goto": "./scripts/git-manager.sh goto"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.7",
